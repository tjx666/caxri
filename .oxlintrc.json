{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    // Oxlint owns type-aware linting (via `oxlint --type-aware` / tsgolint); syntactic rules stay
    // with ESLint (`eslint.config.ts`) so the two linters never overlap. The single exception is
    // `node/no-sync` (see `overrides`): eslint-plugin-n v18's implementation demands a TypeScript
    // program on every lint, which ESLint no longer builds after the type-aware layer moved here.
    "plugins": ["typescript", "node"],
    "categories": {
        "correctness": "off",
        "suspicious": "off",
        "pedantic": "off",
        "perf": "off",
        "style": "off",
        "restriction": "off",
        "nursery": "off"
    },
    "env": {
        "builtin": true
    },
    // Mirrors `globalIgnores` in eslint.config.ts.
    "ignorePatterns": [
        "**/dist/**",
        "logs",
        "out",
        "release",
        "release.noindex",
        "node_modules",
        ".records/**",
        "test-results",
        "competitors/**",
        "**/*.sh",
        "scripts/fixtures/eslint/**",
        "scripts/fixtures/markdown/**",
        ".claude/**",
        // The design-prototype runtime manifest resolves its `@/` imports through esbuild
        // `--alias` flags in build-runtime.ts, not tsconfig paths, so tsgolint sees error types.
        ".agents/skills/design-prototype/assets/entry.mjs",
        ".agents/skills/design-prototype/assets/*.js"
    ],
    "rules": {
        // The type-aware subset the repository previously enabled through
        // `@yutengjing/eslint-config-typescript`'s `typeCheckedConfig` (`recommendedTypeChecked`).
        "typescript/await-thenable": "error",
        "typescript/no-array-delete": "error",
        "typescript/no-base-to-string": "error",
        "typescript/no-duplicate-type-constituents": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-for-in-array": "error",
        "typescript/no-implied-eval": "error",
        "typescript/no-misused-promises": ["error", { "checksVoidReturn": false }],
        "typescript/no-redundant-type-constituents": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-enum-comparison": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-unary-minus": "error",
        "typescript/only-throw-error": "error",
        "typescript/prefer-promise-reject-errors": "error",
        "typescript/require-await": "error",
        "typescript/restrict-plus-operands": "error",
        "typescript/restrict-template-expressions": "error",
        "typescript/unbound-method": "error",
        // High-consensus community additions beyond `recommendedTypeChecked` (researched from
        // typescript-eslint maintainers, epicweb-dev/config ADRs, and practitioner posts):
        // `strict-boolean-expressions` is deliberately excluded as noisy/stylistic per the
        // typescript-eslint maintainers' own assessment (typescript-eslint#2345).
        "typescript/no-deprecated": "error",
        "typescript/no-unnecessary-condition": ["error", { "allowConstantLoopConditions": true }],
        "typescript/prefer-nullish-coalescing": "error",
        "typescript/prefer-optional-chain": "error",
        "typescript/return-await": ["error", "in-try-catch"],
        "typescript/switch-exhaustiveness-check": [
            "error",
            { "considerDefaultExhaustiveForUnions": true }
        ]
    },
    "overrides": [
        {
            // AGENTS.md "Code conventions": prefer asynchronous Node.js APIs over `*Sync` variants
            // in Main, Runtime, and tooling code; test code is exempt. Owned by oxlint because
            // eslint-plugin-n v18's no-sync requires typed linting (see the file header comment).
            "files": [
                "apps/desktop/src/main/**/*.ts",
                "apps/server/src/**/*.ts",
                "packages/system/src/**/*.ts",
                "apps/cli/src/**/*.ts",
                "scripts/**/*.ts",
                ".agents/**/scripts/**/*.ts"
            ],
            "rules": {
                "node/no-sync": "error"
            }
        },
        {
            "files": ["**/*.test.ts", "**/__tests__/**"],
            "rules": {
                "node/no-sync": "off"
            }
        }
    ]
}
