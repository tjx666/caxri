{
    "name": "@caxri/desktop",
    "version": "0.0.104",
    "private": true,
    "description": "Caxri desktop application.",
    "type": "module",
    "main": "../../out/main/index.js",
    "scripts": {
        "build": "bun run --cwd ../.. build:workspaces && bun run --cwd ../.. build:desktop",
        "dev": "bun run --cwd ../.. build:workspaces && bun run --cwd ../.. dev:desktop",
        "test": "vitest run --root ../.. --project desktop-parallel apps/desktop/src",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
    },
    "dependencies": {
        "@base-ui/react": "1.7.0",
        "@caxri/client": "workspace:*",
        "@caxri/markdown": "workspace:*",
        "@caxri/protocol": "workspace:*",
        "@caxri/system": "workspace:*",
        "@caxri/utils": "workspace:*",
        "@lobehub/icons-static-svg": "^1.95.1",
        "@lobehub/ui": "^5.57.3",
        "@monaco-editor/react": "^4.7.0",
        "@tanstack/react-query": "^5.104.1",
        "@tanstack/react-virtual": "^3.14.15",
        "@xterm/addon-clipboard": "0.3.0-beta.303",
        "@xterm/addon-fit": "0.12.0-beta.301",
        "@xterm/addon-image": "0.10.0-beta.301",
        "@xterm/addon-progress": "0.3.0-beta.301",
        "@xterm/addon-search": "0.17.0-beta.301",
        "@xterm/addon-unicode11": "0.10.0-beta.301",
        "@xterm/addon-webgl": "0.20.0-beta.300",
        "@xterm/xterm": "6.1.0-beta.304",
        "@yutengjing/vscode-icons": "^0.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "dompurify": "^3.4.17",
        "es-toolkit": "^1.52.0",
        "fuse.js": "^7.5.0",
        "jsonc-parser": "^3.3.1",
        "lucide-react": "^1.55.0",
        "mermaid": "^12.1.0",
        "monaco-editor": "^0.57.0",
        "motion": "^14.1.0",
        "papaparse": "^5.7.0",
        "pdfjs-dist": "^6.4.299",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-qr-code": "catalog:",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zod": "catalog:",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "electron": "45.0.0-beta.1",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vitest": "^5.0.3"
    }
}
