{
    "name": "@caxri/desktop",
    "version": "0.0.38",
    "private": true,
    "description": "Caxri desktop application.",
    "type": "module",
    "main": "../../out/main/index.js",
    "scripts": {
        "build": "bun run --cwd ../.. build:workspaces && bun run --cwd ../.. build:desktop",
        "dev": "bun run --cwd ../.. build:workspaces && bun run --cwd ../.. dev:desktop",
        "test": "vitest run --root ../.. --project desktop-parallel apps/desktop/src",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
    },
    "dependencies": {
        "@base-ui/react": "1.7.0",
        "@caxri/client": "workspace:*",
        "@caxri/protocol": "workspace:*",
        "@caxri/system": "workspace:*",
        "@caxri/utils": "workspace:*",
        "@lobehub/icons-static-svg": "^1.94.0",
        "@monaco-editor/react": "4.7.0",
        "@tanstack/react-query": "5.102.8",
        "@tanstack/react-virtual": "3.14.10",
        "@xterm/addon-clipboard": "0.3.0-beta.302",
        "@xterm/addon-fit": "0.12.0-beta.300",
        "@xterm/addon-image": "0.10.0-beta.300",
        "@xterm/addon-progress": "0.3.0-beta.300",
        "@xterm/addon-search": "0.17.0-beta.300",
        "@xterm/addon-unicode11": "0.10.0-beta.300",
        "@xterm/addon-webgl": "0.20.0-beta.299",
        "@xterm/xterm": "6.1.0-beta.303",
        "@yutengjing/vscode-icons": "^0.1.1",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "cmdk": "1.1.1",
        "es-toolkit": "1.52.0",
        "fuse.js": "7.5.0",
        "jsonc-parser": "3.3.1",
        "lucide-react": "1.37.0",
        "monaco-editor": "0.56.0",
        "motion": "13.1.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-qr-code": "catalog:",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "zod": "catalog:",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@types/node": "26.4.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "electron": "44.0.0",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vitest": "4.1.11"
    }
}
