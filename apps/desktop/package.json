{
    "name": "@caxri/desktop",
    "version": "0.0.146",
    "private": true,
    "description": "Caxri desktop application.",
    "type": "module",
    "main": "../../out/main/index.js",
    "scripts": {
        "build": "bun run --cwd ../.. build:workspaces && bun run --cwd ../.. build:desktop",
        "dev": "bun run --cwd ../.. build:workspaces && bun run --cwd ../.. dev:desktop",
        "test": "vitest run --root ../.. --project desktop-parallel apps/desktop/src",
        "typecheck": "bun check --no-script -p tsconfig.node.json && bun check --no-script -p tsconfig.web.json"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@caxri/client": "workspace:*",
        "@caxri/markdown": "workspace:*",
        "@caxri/protocol": "workspace:*",
        "@caxri/system": "workspace:*",
        "@caxri/utils": "workspace:*",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@lezer/markdown": "^1.8.1",
        "@lobehub/icons-static-svg": "^1.95.1",
        "@lobehub/ui": "^6.5.1",
        "@monaco-editor/react": "^4.7.0",
        "@number-flow/react": "^0.6.2",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-virtual": "^3.14.21",
        "@tensorflow/tfjs-backend-cpu": "^3.21.0",
        "@tensorflow/tfjs-converter": "^3.21.0",
        "@tensorflow/tfjs-core": "^3.21.0",
        "@vscode/vscode-languagedetection": "^1.0.23",
        "@xterm/addon-clipboard": "0.3.0-beta.313",
        "@xterm/addon-fit": "0.12.0-beta.311",
        "@xterm/addon-image": "0.10.0-beta.310",
        "@xterm/addon-progress": "0.3.0-beta.310",
        "@xterm/addon-search": "0.17.0-beta.310",
        "@xterm/addon-unicode11": "0.10.0-beta.310",
        "@xterm/addon-webgl": "0.20.0-beta.309",
        "@xterm/xterm": "6.1.0-beta.315",
        "@yutengjing/vscode-icons": "^0.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "dompurify": "^3.4.17",
        "es-toolkit": "^1.52.0",
        "jsonc-parser": "^3.3.1",
        "lucide-react": "^1.59.0",
        "mermaid": "^12.2.0",
        "monaco-editor": "^0.57.0",
        "motion": "^14.4.0",
        "papaparse": "^5.7.0",
        "pdfjs-dist": "^6.4.299",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-qr-code": "catalog:",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zod": "catalog:",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "electron": "^45.0.0",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vitest": "^5.0.5"
    }
