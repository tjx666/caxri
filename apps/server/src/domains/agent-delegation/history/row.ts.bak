import { createHash } from 'node:crypto';

import type { Principal } from '@caxri/protocol';
import { isDelegationActive } from '@caxri/protocol';

import type { DelegationHistoryInsert, StoredAgentDelegation } from '../../db';
import { delegationResultSummary } from '../feed/result-summary';

/**
 * Longest Session title a history row keeps, in characters.
 */
export const MAX_HISTORY_TITLE_LENGTH = 200;

/**
 * Rows that keep searchable text (title and summary); older rows are compacted, never deleted.
 */
export const MAX_SEARCHABLE_DELEGATION_HISTORY = 5000;

/**
 * The stable digest of a principal, compared in place of the principal JSON itself so a stored row never holds an
 * Endpoint identity. Both sides hash the same `JSON.stringify` the task ownership rule compares.
 */
export function principalHash(principal: Principal): string {
    return createHash('sha256').update(JSON.stringify(principal)).digest('hex');
}

/**
 * Builds the history row of a settled task. The title is a snapshot of the Session's title now, because a task record
 * does not hold it; a Session already gone stores none. Only a completed task has a summary, and counters the provider
 * did not report stay NULL (unknown), never 0.
 */
export function historyRow(
    saved: StoredAgentDelegation,
    title: string | undefined,
): DelegationHistoryInsert {
    const { receipt } = saved;
    if (isDelegationActive(receipt)) throw new Error('Only a settled task has a history row');
    const outcome = receipt.status as DelegationHistoryInsert['outcome'];
    const summary =
        outcome === 'completed' && saved.answer
            ? delegationResultSummary(saved.answer.text)
            : undefined;
    const { usage, selection } = receipt;
    return {
        delegationId: receipt.delegationId,
        rootDelegationId: saved.rootDelegationId ?? receipt.delegationId,
        retryOf: receipt.retryOf ?? null,
        sessionId: receipt.sessionId,
        projectId: receipt.projectId,
        ownerTerminalId: receipt.callerTerminalId ?? null,
        ownerPrincipalHash: principalHash(saved.principal),
        provider: receipt.provider,
        selectionModel: selection?.model ?? null,
        selectionEffort: selection?.effort ?? null,
        outcome,
        failure: outcome === 'completed' ? null : (receipt.failure ?? null),
        title: title ? title.slice(0, MAX_HISTORY_TITLE_LENGTH) : null,
        summary: summary?.text ?? null,
        summarySource: summary?.source ?? null,
        inputTokens: usage?.inputTokens ?? null,
        outputTokens: usage?.outputTokens ?? null,
        cacheReadTokens: usage?.cacheReadTokens ?? null,
        cacheWriteTokens: usage?.cacheWriteTokens ?? null,
        reasoningTokens: usage?.reasoningTokens ?? null,
        totalTokens: usage?.totalTokens ?? null,
        usageScope: usage?.scope ?? null,
        createdAt: receipt.createdAt,
        settledAt: Math.max(receipt.settledAt ?? receipt.updatedAt, receipt.createdAt),
        compactedAt: null,
    };
}
