{
    "name": "@caxri/server",
    "version": "0.0.96",
    "private": true,
    "description": "Caxri Server application.",
    "type": "module",
    "main": "dist/server/bundles/server-core.js",
    "scripts": {
        "build": "vite build --config vite.config.ts && bun run scripts/build-artifact.ts",
        "dev": "bun run scripts/watch.ts",
        "test": "vitest run --root ../.. --project server-parallel --project server-serial-native",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.295",
        "@caxri/agent-skills": "workspace:*",
        "@caxri/mobile-transport": "workspace:*",
        "@caxri/protocol": "workspace:*",
        "@caxri/system": "workspace:*",
        "@caxri/utils": "workspace:*",
        "@parcel/watcher": "^2.6.0",
        "@vscode/ripgrep-universal": "^1.18.0",
        "@xterm/addon-serialize": "0.15.0-beta.301",
        "@xterm/addon-unicode11": "0.10.0-beta.301",
        "@xterm/headless": "6.1.0-beta.303",
        "archiver": "^8.0.0",
        "better-sqlite3": "^13.0.3",
        "caxri": "workspace:*",
        "drizzle-orm": "^0.45.2",
        "es-toolkit": "^1.52.0",
        "jsonc-parser": "^3.3.1",
        "node-pty": "^1.1.0",
        "plist": "^5.0.0",
        "semver": "catalog:",
        "ws": "catalog:",
        "yaml": "^2.9.1",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/archiver": "^8.0.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.2",
        "@types/semver": "catalog:",
        "@types/ws": "catalog:",
        "vite": "^8.3.0"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "files": [
        "dist/server"
    ]
}
