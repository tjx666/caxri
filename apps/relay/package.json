{
    "name": "@caxri/relay",
    "version": "0.0.1",
    "private": true,
    "description": "Caxri Relay: a stateless rendezvous service that splices phones to Servers behind NAT.",
    "type": "module",
    "main": "dist/relay.mjs",
    "scripts": {
        "build": "bun build src/main.ts --target=node --conditions=bun --format=esm --outfile dist/relay.mjs",
        "dev": "bun --watch src/main.ts",
        "docker:build": "docker build -f Dockerfile -t caxri-relay:local ../..",
        "docker:smoke": "bun run scripts/docker-smoke.ts",
        "start": "node dist/relay.mjs",
        "test": "vitest run --root ../.. --project relay",
        "typecheck": "bun check --no-script -p tsconfig.json"
    },
    "dependencies": {
        "@caxri/mobile-transport": "workspace:*",
        "ws": "catalog:"
    },
    "devDependencies": {
        "@types/ws": "catalog:"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
