{
    "extends": "expo/tsconfig.base.json",
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "lib": ["ES2022", "WebWorker"],
        "strict": true,
        "types": []
    },
    "include": [
        "app/**/*.ts",
        "app/**/*.tsx",
        "src/**/*.ts",
        "src/**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ],
    "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
