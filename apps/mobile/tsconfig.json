{
    "extends": "expo/tsconfig.base.json",
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "strict": true,
        "types": ["node"]
    },
    "include": [
        "app/**/*.ts",
        "app/**/*.tsx",
        "plugins/**/*.ts",
        "scripts/**/*.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ]
}
