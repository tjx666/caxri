{
    "name": "@caxri/mobile",
    "version": "0.0.147",
    "private": true,
    "description": "Caxri mobile companion for paired Agent Sessions.",
    "main": "expo-router/entry",
    "scripts": {
        "build:dependencies": "bun run --cwd ../../packages/utils build && bun run --cwd ../../packages/protocol build && bun run --cwd ../../packages/markdown build && bun run --cwd ../../packages/mobile-transport build && bun run build:terminal-webview",
        "build:file-icons": "bun run scripts/build-file-icons.ts",
        "build:terminal-webview": "bun run scripts/build-terminal-webview.ts",
        "build:update-bundle": "bun run scripts/build-update-bundle.ts",
        "dev": "bun run build:dependencies && EXPO_UNSTABLE_MCP_SERVER=1 expo start --dev-client --lan",
        "dev:reset": "bun run build:dependencies && EXPO_UNSTABLE_MCP_SERVER=1 expo start --dev-client --clear --lan",
        "android": "bun run build:dependencies && bun run scripts/android-build.ts",
        "android:device": "bun run scripts/android-device.ts",
        "agent-device": "agent-device",
        "android:benchmark": "bun run scripts/android-benchmark.ts",
        "android:flows": "bun run scripts/android-flows.ts",
        "android:performance": "bun run scripts/android-performance.ts",
        "ios": "bun run build:dependencies && EXPO_NO_GIT_STATUS=1 expo run:ios",
        "prebuild:android": "bun run build:dependencies && EXPO_NO_GIT_STATUS=1 expo prebuild --platform android",
        "prebuild:ios": "bun run build:dependencies && EXPO_NO_GIT_STATUS=1 expo prebuild --platform ios",
        "test": "vitest run --root ../.. --project mobile",
        "typecheck": "bun check --no-script -p tsconfig.runtime.json && bun check --no-script -p tsconfig.json"
    },
    "dependencies": {
        "@caxri/markdown": "workspace:*",
        "@caxri/mobile-transport": "workspace:*",
        "@caxri/protocol": "workspace:*",
        "@react-native-masked-view/masked-view": "0.3.2",
        "@ronradtke/react-native-markdown-display": "catalog:",
        "@shopify/flash-list": "2.3.2",
        "@tanstack/react-query": "catalog:",
        "@xterm/xterm": "6.1.0-beta.315",
        "expo": "~58.0.16",
        "expo-camera": "~58.0.11",
        "expo-clipboard": "~58.0.3",
        "expo-constants": "npm:expo-constants@58.0.12",
        "expo-crypto": "~58.0.7",
        "expo-dev-client": "~58.0.14",
        "expo-device": "~58.0.5",
        "expo-document-picker": "catalog:",
        "expo-file-system": "catalog:",
        "expo-image-manipulator": "catalog:",
        "expo-image-picker": "catalog:",
        "expo-intent-launcher": "catalog:",
        "expo-linking": "~58.0.13",
        "expo-network": "~58.0.3",
        "expo-router": "~58.0.24",
        "expo-secure-store": "~58.0.2",
        "expo-splash-screen": "~58.0.10",
        "expo-status-bar": "~58.0.3",
        "expo-system-ui": "~58.0.6",
        "lucide-react-native": "catalog:",
        "markdown-it": "catalog:",
        "prism-react-renderer": "catalog:",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.0",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-svg": "15.16.0",
        "react-native-webview": "14.0.1",
        "react-native-worklets": "0.13.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@caxri/utils": "workspace:*",
        "@perf-profiler/e2e": "^0.11.3",
        "@perf-profiler/types": "^0.8.0",
        "@react-native/metro-config": "0.88.0",
        "@types/react": "~19.3.0",
        "@yutengjing/vscode-icons": "^0.2.0",
        "agent-device": "^0.21.35",
        "svgo": "^4.1.0",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
