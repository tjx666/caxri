{
    "name": "@caxri/mobile",
    "version": "0.0.97",
    "private": true,
    "description": "Caxri mobile companion for paired Agent Sessions.",
    "main": "expo-router/entry",
    "scripts": {
        "build:dependencies": "bun run --cwd ../../packages/utils build && bun run --cwd ../../packages/protocol build && bun run --cwd ../../packages/mobile-transport build && bun run build:terminal-webview",
        "build:file-icons": "bun run scripts/build-file-icons.ts",
        "build:terminal-webview": "bun run scripts/build-terminal-webview.ts",
        "build:update-bundle": "bun run scripts/build-update-bundle.ts",
        "dev": "bun run build:dependencies && EXPO_UNSTABLE_MCP_SERVER=1 expo start --dev-client --lan",
        "dev:reset": "bun run build:dependencies && EXPO_UNSTABLE_MCP_SERVER=1 expo start --dev-client --clear --lan",
        "android": "bun run build:dependencies && bun run scripts/android-build.ts",
        "android:device": "bun run scripts/android-device.ts",
        "android:performance": "bun run scripts/android-performance.ts",
        "ios": "bun run build:dependencies && EXPO_NO_GIT_STATUS=1 expo run:ios",
        "prebuild:android": "bun run build:dependencies && EXPO_NO_GIT_STATUS=1 expo prebuild --platform android",
        "prebuild:ios": "bun run build:dependencies && EXPO_NO_GIT_STATUS=1 expo prebuild --platform ios",
        "test": "vitest run --root ../.. --project mobile",
        "typecheck": "tsc --noEmit -p tsconfig.runtime.json && tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@caxri/mobile-transport": "workspace:*",
        "@caxri/protocol": "workspace:*",
        "@ronradtke/react-native-markdown-display": "catalog:",
        "@shopify/flash-list": "2.0.2",
        "@tanstack/react-query": "catalog:",
        "@xterm/xterm": "6.1.0-beta.304",
        "expo": "~57.0.28",
        "expo-camera": "~57.0.6",
        "expo-clipboard": "~57.0.2",
        "expo-constants": "npm:expo-constants@57.0.21",
        "expo-crypto": "~57.0.4",
        "expo-dev-client": "~57.0.20",
        "expo-device": "~57.0.2",
        "expo-file-system": "catalog:",
        "expo-image-manipulator": "catalog:",
        "expo-image-picker": "catalog:",
        "expo-intent-launcher": "catalog:",
        "expo-linking": "~57.0.12",
        "expo-network": "~57.0.2",
        "expo-router": "~57.0.26",
        "expo-secure-store": "~57.0.4",
        "expo-splash-screen": "~57.0.10",
        "expo-status-bar": "~57.0.1",
        "expo-system-ui": "~57.0.4",
        "lucide-react-native": "catalog:",
        "prism-react-renderer": "catalog:",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.3",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.2",
        "react-native-svg": "15.15.4",
        "react-native-webview": "13.16.1",
        "react-native-worklets": "0.10.1",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@caxri/utils": "workspace:*",
        "@react-native/metro-config": "0.86.3",
        "@types/react": "~19.2.18",
        "@yutengjing/vscode-icons": "^0.2.0",
        "svgo": "^4.1.0",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "expo": {
        "install": {
            "exclude": [
                "react-native-reanimated"
            ]
        }
    }
}
