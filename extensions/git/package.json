{
    "name": "caxri.git",
    "version": "0.0.119",
    "private": true,
    "type": "module",
    "main": "./dist/extension.js",
    "scripts": {
        "build": "bun run --cwd ../.. scripts/build-extension.ts --extension-root extensions/git",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@caxri/protocol": "workspace:*",
        "@caxri/utils": "workspace:*",
        "caxri": "workspace:*"
    },
    "engines": {
        "caxri": "^0.0.119"
    },
    "caxri": {
        "capabilities": [
            "git.read",
            "git.write",
            "settings.read"
        ]
    },
    "contributes": {
        "viewsContainers": {
            "secondarySidebar": [
                {
                    "id": "caxri.git",
                    "title": "Git",
                    "order": 200,
                    "icon": {
                        "kind": "builtin",
                        "id": "git-branch"
                    },
                    "command": "secondarySidebar.showGit"
                }
            ]
        },
        "views": {
            "caxri.git": [
                {
                    "id": "caxri.git.sourceControl",
                    "name": "Source Control",
                    "type": "source-control",
                    "badge": true,
                    "presentation": {
                        "noContextMessage": "Pick a Session to inspect its Git state.",
                        "loadingMessage": "Loading Git status…",
                        "actionErrorMessage": "Git action failed",
                        "refreshErrorMessage": "Git refresh failed"
                    },
                    "configurationDependencies": [
                        "git.fetchGitHubAvatars",
                        "git.diffExclude"
                    ]
                }
            ]
        },
        "commands": [
            {
                "command": "caxri.git.workingTree",
                "title": "Working Tree Changes"
            },
            {
                "command": "caxri.git.lastCommit",
                "title": "Last Commit Changes"
            },
            {
                "command": "caxri.git.pullRequest",
                "title": "Pull Request Changes"
            },
            {
                "command": "caxri.git.refresh",
                "title": "Refresh Git"
            },
            {
                "command": "caxri.git.sync",
                "title": "Sync Changes",
                "palette": false
            },
            {
                "command": "caxri.git.discardAll",
                "title": "Discard All Changes",
                "palette": false
            },
            {
                "command": "caxri.git.discard",
                "title": "Discard Changes",
                "palette": false
            },
            {
                "command": "caxri.git.openChanges",
                "title": "Open Changes",
                "palette": false
            },
            {
                "command": "caxri.git.history",
                "title": "Show Repository History",
                "palette": false
            },
            {
                "command": "caxri.git.openCommit",
                "title": "Open Git Commit",
                "palette": false
            }
        ]
    }
}
