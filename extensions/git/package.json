{
    "name": "caxri.git",
    "version": "0.0.147",
    "private": true,
    "type": "module",
    "main": "./dist/extension.js",
    "scripts": {
        "build": "bun run --cwd ../.. scripts/build-extension.ts --extension-root extensions/git",
        "typecheck": "bun check --no-script -p tsconfig.json"
    },
    "devDependencies": {
        "@caxri/protocol": "workspace:*",
        "@caxri/utils": "workspace:*",
        "caxri": "workspace:*"
    },
    "engines": {
        "caxri": "^0.0.147"
    },
    "caxri": {
        "capabilities": [
            "git.read",
            "git.write",
            "settings.read"
        ]
    },
    "contributes": {
        "viewsContainers": {
            "secondarySidebar": [
                {
                    "id": "caxri.git",
                    "title": "Git",
                    "order": 200,
                    "icon": {
                        "kind": "builtin",
                        "id": "git-branch"
                    },
                    "command": "secondarySidebar.showGit"
                }
            ]
        },
        "views": {
            "caxri.git": [
                {
                    "id": "caxri.git.sourceControl",
                    "name": "%views.sourceControl.name%",
                    "type": "source-control",
                    "badge": true,
                    "presentation": {
                        "noContextMessage": "%views.sourceControl.noContextMessage%",
                        "loadingMessage": "%views.sourceControl.loadingMessage%",
                        "actionErrorMessage": "%views.sourceControl.actionErrorMessage%",
                        "refreshErrorMessage": "%views.sourceControl.refreshErrorMessage%"
                    },
                    "configurationDependencies": [
                        "git.fetchGitHubAvatars",
                        "git.diffExclude"
                    ]
                }
            ]
        },
        "commands": [
            {
                "command": "caxri.git.workingTree",
                "title": "%commands.workingTree.title%"
            },
            {
                "command": "caxri.git.lastCommit",
                "title": "%commands.lastCommit.title%"
            },
            {
                "command": "caxri.git.pullRequest",
                "title": "%commands.pullRequest.title%"
            },
            {
                "command": "caxri.git.refresh",
                "title": "%commands.refresh.title%"
            },
            {
                "command": "caxri.git.sync",
                "title": "%commands.sync.title%",
                "palette": false
            },
            {
                "command": "caxri.git.discardAll",
                "title": "%commands.discardAll.title%",
                "palette": false
            },
            {
                "command": "caxri.git.discard",
                "title": "%commands.discard.title%",
                "palette": false
            },
            {
                "command": "caxri.git.openChanges",
                "title": "%commands.openChanges.title%",
                "palette": false
            },
            {
                "command": "caxri.git.history",
                "title": "%commands.history.title%",
                "palette": false
            },
            {
                "command": "caxri.git.openCommit",
                "title": "%commands.openCommit.title%",
                "palette": false
            }
        ]
    }
}
