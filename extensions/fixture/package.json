{
    "name": "caxri.fixture",
    "version": "0.0.109",
    "private": true,
    "type": "module",
    "main": "./dist/extension.js",
    "scripts": {
        "build": "bun run --cwd ../.. scripts/build-extension.ts --extension-root extensions/fixture",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@caxri/protocol": "workspace:*",
        "caxri": "workspace:*"
    },
    "engines": {
        "caxri": "^0.0.109"
    },
    "caxri": {
        "capabilities": [
            "projects.read"
        ],
        "testOnly": true
    },
    "contributes": {
        "viewsContainers": {
            "secondarySidebar": [
                {
                    "id": "caxri.fixture",
                    "title": "Extension Fixture",
                    "order": 300,
                    "icon": {
                        "kind": "resource",
                        "path": "media/fixture.svg"
                    }
                }
            ]
        },
        "views": {
            "caxri.fixture": [
                {
                    "id": "caxri.fixture.tree",
                    "name": "Fixture Tree",
                    "type": "tree",
                    "actions": [
                        {
                            "command": "caxri.fixture.refresh",
                            "role": "resource.refresh"
                        }
                    ]
                }
            ]
        },
        "commands": [
            {
                "command": "caxri.fixture.refresh",
                "title": "Refresh Extension Fixture"
            },
            {
                "command": "caxri.fixture.refreshTarget",
                "title": "Refresh Extension Fixture Target"
            },
            {
                "command": "caxri.fixture.increment",
                "title": "Increment Extension Fixture Counter"
            },
            {
                "command": "caxri.fixture.crashHost",
                "title": "Crash Extension Host"
            }
        ]
    }
}
