{
    "name": "caxri.fixture",
    "version": "0.0.17",
    "private": true,
    "type": "module",
    "main": "./dist/extension.js",
    "scripts": {
        "build": "bun run --cwd ../.. scripts/build-extension.ts --extension-root extensions/fixture",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "caxri": "workspace:*"
    },
    "engines": {
        "caxri": "^0.0.17"
    },
    "caxri": {
        "capabilities": [
            "projects.read"
        ],
        "testOnly": true
    },
    "contributes": {
        "viewsContainers": {
            "secondarySidebar": [
                {
                    "id": "caxri.fixture",
                    "title": "Extension Fixture",
                    "icon": {
                        "kind": "resource",
                        "path": "media/fixture.svg"
                    }
                }
            ]
        },
        "views": {
            "caxri.fixture": [
                {
                    "id": "caxri.fixture.tree",
                    "name": "Fixture Tree",
                    "type": "tree"
                }
            ]
        },
        "commands": [
            {
                "command": "caxri.fixture.refresh",
                "title": "Refresh Extension Fixture"
            },
            {
                "command": "caxri.fixture.crashHost",
                "title": "Crash Extension Host"
            }
        ]
    }
}
