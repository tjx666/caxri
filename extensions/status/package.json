{
    "name": "caxri.project-status",
    "version": "0.0.76",
    "private": true,
    "type": "module",
    "main": "./dist/extension.js",
    "scripts": {
        "build": "bun run --cwd ../.. scripts/build-extension.ts --extension-root extensions/status",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@caxri/protocol": "workspace:*",
        "caxri": "workspace:*"
    },
    "engines": {
        "caxri": "^0.0.76"
    },
    "caxri": {
        "capabilities": [
            "projects.read"
        ]
    },
    "contributes": {
        "viewsContainers": {
            "secondarySidebar": [
                {
                    "id": "caxri.project-status",
                    "title": "Status",
                    "order": 400,
                    "icon": {
                        "kind": "builtin",
                        "id": "status"
                    },
                    "command": "secondarySidebar.showStatus"
                }
            ]
        },
        "views": {
            "caxri.project-status": [
                {
                    "id": "caxri.project-status.overview",
                    "name": "Project Status",
                    "type": "tree",
                    "badge": true,
                    "actions": [
                        {
                            "command": "caxri.project-status.refresh",
                            "role": "resource.refresh"
                        }
                    ]
                }
            ]
        },
        "commands": [
            {
                "command": "caxri.project-status.refresh",
                "title": "Refresh Project Status",
                "description": "Refresh Project Status from GitHub, Linear, and Vercel"
            }
        ]
    }
}
