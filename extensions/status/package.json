{
    "name": "caxri.project-status",
    "version": "0.0.148",
    "private": true,
    "type": "module",
    "main": "./dist/extension.js",
    "scripts": {
        "build": "bun run --cwd ../.. scripts/build-extension.ts --extension-root extensions/status",
        "typecheck": "bun check --no-script -p tsconfig.json"
    },
    "devDependencies": {
        "@caxri/protocol": "workspace:*",
        "caxri": "workspace:*"
    },
    "engines": {
        "caxri": "^0.0.148"
    },
    "caxri": {
        "capabilities": [
            "git.write",
            "projects.read"
        ]
    },
    "contributes": {
        "viewsContainers": {
            "secondarySidebar": [
                {
                    "id": "caxri.project-status",
                    "title": "%viewsContainers.project-status.title%",
                    "order": 400,
                    "icon": {
                        "kind": "builtin",
                        "id": "status"
                    },
                    "command": "secondarySidebar.showStatus"
                }
            ]
        },
        "views": {
            "caxri.project-status": [
                {
                    "id": "caxri.project-status.overview",
                    "name": "%views.overview.name%",
                    "type": "tree",
                    "badge": true,
                    "actions": [
                        {
                            "command": "caxri.project-status.refresh",
                            "role": "resource.refresh"
                        }
                    ]
                }
            ]
        },
        "commands": [
            {
                "command": "caxri.project-status.refresh",
                "title": "%commands.refresh.title%",
                "description": "%commands.refresh.description%"
            },
            {
                "command": "caxri.project-status.mergePullRequest",
                "title": "%commands.mergePullRequest.title%",
                "palette": false
            },
            {
                "command": "caxri.project-status.mergeCurrentPullRequest",
                "title": "%commands.mergeCurrentPullRequest.title%",
                "description": "%commands.mergeCurrentPullRequest.description%"
            }
        ]
    }
}
