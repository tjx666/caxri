{
    "permissions": {
        "allow": [
            "Bash(bun run typecheck)",
            "Bash(bun run lint)",
            "Bash(bun run knip)",
            "Bash(bun run doctor)",
            "Bash(bun run format:check)",
            "Bash(bun run format:md:check)",
            "Bash(bun run test)",
            "Bash(bun run test:smoke)",
            "Bash(bun run check *)",
            "Bash(bun run --silent check *)",
            "Bash(bun run doctor:changed)",
            "Bash(bun run lint:type-aware)",
            "Bash(bun run lint:markdown)",
            "Bash(bunx vitest run *)",
            "mcp__exa__web_search_exa",
            "mcp__exa__web_fetch_exa"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bun run \"${CLAUDE_PROJECT_DIR}/.agents/skills/acceptance/scripts/pre-tool-use.ts\"",
                        "statusMessage": "Checking Caxri command usage",
                        "timeout": 5
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|resume|clear",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bun run \"${CLAUDE_PROJECT_DIR}/.agents/skills/switch-worktree/scripts/switch-worktree.ts\" orphans",
                        "statusMessage": "Checking for orphaned Caxri dev processes",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
