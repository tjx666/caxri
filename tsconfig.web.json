{
    "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
    "exclude": ["src/**/__tests__/**", "src/shared/node/**"],
    "include": ["src/renderer/src/**/*.ts", "src/renderer/src/**/*.tsx", "src/shared/**/*.ts"],
    "compilerOptions": {
        "composite": true,
        "jsx": "react-jsx",
        "noEmit": true,
        "strict": true,
        "paths": {
            "@/*": ["./src/renderer/src/*"],
            "@shared/*": ["./src/shared/*"]
        }
    }
}
