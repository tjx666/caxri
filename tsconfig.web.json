{
    "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
    "exclude": [
        "src/**/__tests__/**",
        "src/shared/node/**",
        "packages/**/__tests__/**",
        "packages/**/*.test.ts"
    ],
    "include": [
        "src/renderer/src/**/*.ts",
        "src/renderer/src/**/*.tsx",
        "src/shared/**/*.ts",
        "packages/protocol/src/**/*.ts"
    ],
    "compilerOptions": {
        "composite": true,
        "jsx": "react-jsx",
        "noEmit": true,
        "strict": true,
        "paths": {
            "@/*": ["./src/renderer/src/*"],
            "@shared/*": ["./src/shared/*"]
        }
    }
}
