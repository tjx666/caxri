{
    "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
    "include": [
        "electron.vite.config.*",
        "drizzle.config.*",
        "vitest.config.*",
        "playwright.config.*",
        "eslint.config.*",
        "src/main/**/*.ts",
        "src/preload/**/*.ts",
        "src/renderer/__tests__/**/*.ts",
        "src/runtime/**/*.ts",
        "src/shared/**/*.ts",
        "packages/**/*.ts",
        ".agents/skills/**/scripts/**/*.ts",
        "scripts/**/*.ts",
        "e2e/**/*.ts"
    ],
    "compilerOptions": {
        "composite": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "noEmit": true,
        "strict": true,
        "types": ["node", "electron"]
    }
}
