{
    "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
    "include": [
        "types/**/*.d.ts",
        "electron.vite.config.*",
        "drizzle.config.*",
        "vitest.config.*",
        "vitest.global-setup.ts",
        "playwright.config.*",
        "eslint.config.*",
        "apps/cli/scripts/**/*.ts",
        "apps/server/scripts/**/*.ts",
        "apps/server/vite.config.ts",
        ".agents/skills/**/scripts/**/*.ts",
        "scripts/**/*.ts",
        "scripts/fixtures/eslint/**/*.tsx",
        "e2e/**/*.ts"
    ],
    "compilerOptions": {
        "composite": false,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "noEmit": true,
        "noImplicitAny": true,
        "paths": {
            "caxri": ["./packages/extension-api/src/index.ts"]
        },
        "strict": true,
        "types": ["node", "electron"]
    }
}
