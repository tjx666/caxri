{
    "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
    "include": [
        "types/**/*.d.ts",
        "electron.vite.config.*",
        "drizzle.config.*",
        "vitest.config.*",
        "vitest.global-setup.ts",
        "playwright.config.*",
        "eslint.config.*",
        "apps/cli/**/*.ts",
        "apps/desktop/src/main/**/*.ts",
        "apps/desktop/src/preload/**/*.ts",
        "apps/desktop/src/renderer/__tests__/**/*.ts",
        "apps/desktop/src/shared/**/*.ts",
        "apps/server/**/*.ts",
        "apps/relay/**/*.ts",
        "apps/mobile/scripts/update-bundle-receipts.ts",
        "apps/mobile/plugins/android-release-signing-environment.json",
        // The platform-neutral phone client modules `scripts/relay-link-benchmark.ts` drives from Node.
        "apps/mobile/src/features/agent-chat/agent-chat-sync.ts",
        "apps/mobile/src/features/connection/connection-state.ts",
        "apps/mobile/src/features/connection/credential-store.ts",
        "apps/mobile/src/features/connection/direct-route-probe.ts",
        "apps/mobile/src/features/connection/discard-socket.ts",
        "apps/mobile/src/features/connection/gateway-routes.ts",
        "apps/mobile/src/features/connection/mobile-frame-router.ts",
        "apps/mobile/src/features/connection/mobile-gateway-client.ts",
        "apps/mobile/src/features/connection/mobile-gateway-errors.ts",
        "apps/mobile/src/features/connection/mobile-gateway-session.ts",
        "apps/mobile/src/features/connection/mobile-heartbeat.ts",
        "apps/mobile/src/features/connection/mobile-read-timeouts.ts",
        "apps/mobile/src/features/connection/pairing-client-hello.ts",
        "apps/mobile/src/features/connection/pairing-credential.ts",
        "apps/mobile/src/features/connection/pairing-socket-runtime.ts",
        "apps/mobile/src/features/connection/route-hints.ts",
        "apps/mobile/src/features/connection/socket-reader-budget.ts",
        "apps/mobile/src/features/connection/socket-reader.ts",
        "apps/mobile/src/features/sessions/dashboard-query.ts",
        "apps/mobile/src/lib/notify-listeners.ts",
        "packages/**/*.ts",
        ".agents/skills/**/scripts/**/*.ts",
        "scripts/**/*.ts",
        "scripts/fixtures/eslint/**/*.tsx",
        "e2e/**/*.ts"
    ],
    "compilerOptions": {
        "composite": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "noEmit": true,
        "noImplicitAny": true,
        "paths": {
            "caxri": ["./packages/extension-api/src/index.ts"]
        },
        "strict": true,
        "types": ["node", "electron"]
    }
}
