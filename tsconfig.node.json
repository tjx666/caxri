{
    "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
    "include": [
        "types/**/*.d.ts",
        "prettier.config.ts",
        "electron.vite.config.*",
        "drizzle.config.*",
        "vitest.config.*",
        "playwright.config.*",
        "eslint.config.*",
        "apps/cli/**/*.ts",
        "apps/desktop/src/main/**/*.ts",
        "apps/desktop/src/preload/**/*.ts",
        "apps/desktop/src/renderer/__tests__/**/*.ts",
        "apps/desktop/src/shared/**/*.ts",
        "apps/server/**/*.ts",
        "packages/**/*.ts",
        ".agents/skills/**/scripts/**/*.ts",
        "scripts/**/*.ts",
        "scripts/fixtures/eslint/**/*.tsx",
        "e2e/**/*.ts"
    ],
    "compilerOptions": {
        "composite": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "noEmit": true,
        "noImplicitAny": true,
        "strict": true,
        "types": ["node", "electron"]
    }
}
