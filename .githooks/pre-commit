#!/usr/bin/env sh
set -e

bun run lint:staged

# Scans the Git index -- the same diff this commit is about to create -- independent of lint-staged's per-file-type
# routing, so a secret is caught even in a file type lint-staged does not otherwise touch. `--redact` keeps a real
# secret out of terminal scrollback even when this fails.
bun run gitleaks -- --staged

# Runs unscoped on purpose: README-index completeness and cross-document links are repository-wide properties that a
# per-file run cannot see, and the full pass stays well under a second.
# It also runs when any staged path is deleted or renamed: a code-only rename of a file a document cites passes without
# touching Markdown but fails the same check in CI's guards job.
if git diff --cached --name-only --diff-filter=ACM -- '*.md' | grep -q . ||
    git diff --cached --name-status --diff-filter=DR | grep -q .; then
    bun run docs-check
fi

# The ratchet compares the branch against its merge base with `origin/main`, so it also catches an earlier commit on
# this branch that grew a file past 600 lines. Running it here stops that growth before CI's full platform checks
# are the first to see it. `--staged` measures the index, so a split whose remaining renames are still unstaged does
# not fail a commit that leaves them out.
if git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.mts' '*.cts' '*.js' | grep -q .; then
    bun run source-size-ratchet --staged
fi

# Scans every file in the index, so an em-dash in any staged text file fails here instead of in CI's guards job, while
# an unstaged edit stays out of this commit's verdict; the pass is a single `git grep --cached`.
bun run em-dash-check --staged

# The same directory-density ratchet the `guards` job runs: it only changes when a file is added, deleted, or renamed
# (a pure edit cannot move a directory's file count), so gate on those statuses and skip it for ordinary edits.
if git diff --cached --name-status --diff-filter=ADR | grep -q .; then
    bunx vitest run scripts/__tests__/directory-density-ratchet.test.ts
fi

# The same React Compiler coverage test the `guards` job runs. It compiles every Renderer source (tens of seconds), so
# run it only when a staged Renderer `.ts`/`.tsx` file, or the compiler's own options and known-bailout ledger, changed.
if git diff --cached --name-only --diff-filter=ACMR |
    grep -Eq '^apps/desktop/src/renderer/src/.*\.tsx?$|^scripts/react-compiler-[^/]*\.ts$'; then
    bunx vitest run scripts/__tests__/react-compiler-coverage.test.ts
fi
