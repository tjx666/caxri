#!/usr/bin/env sh
set -e

bun run lint:staged

# Scans the Git index -- the same diff this commit is about to create -- independent of lint-staged's per-file-type
# routing, so a secret is caught even in a file type lint-staged does not otherwise touch. `--redact` keeps a real
# secret out of terminal scrollback even when this fails.
bun run gitleaks -- --staged

# Runs unscoped on purpose: README-index completeness and cross-document links are repository-wide properties that a
# per-file run cannot see, and the full pass stays well under a second.
if git diff --cached --name-only --diff-filter=ACM -- '*.md' | grep -q .; then
    bun run docs-check
fi

# The ratchet compares the branch against its merge base with `origin/main`, so it also catches an earlier commit on
# this branch that grew a file past 600 lines. Running it here stops that growth before CI's full platform checks
# are the first to see it.
if git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.mts' '*.cts' '*.js' | grep -q .; then
    bun run source-size-ratchet
fi

# Scans the whole tracked tree (the index included), so an em-dash in any staged text file fails here instead of in
# CI's guards job; the pass is a single `git grep`.
bun run em-dash-check
