{
    "description": "Caxri repository command guardrails.",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bun run \"$(git rev-parse --show-toplevel)/.agents/skills/acceptance/scripts/pre-tool-use.ts\"",
                        "statusMessage": "Checking Caxri command usage",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}
