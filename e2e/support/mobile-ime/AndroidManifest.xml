<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="caxri.acceptance.ime">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <application android:label="Caxri acceptance fixture IME">
        <service
            android:name=".FixtureIme"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD"
        >
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
        <receiver android:name=".FixtureInsertReceiver" android:exported="true" />
    </application>
</manifest>
