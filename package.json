{
    "name": "@caxri/workspace",
    "version": "0.0.146",
    "private": true,
    "author": "Caxri contributors",
    "license": "SEE LICENSE IN LICENSE",
    "description": "An Agent Development Environment (ADE) for macOS.",
    "type": "module",
    "scripts": {
        "dev": "bun run build:workspaces && bun run electron:install && bun run scripts/development.ts",
        "dev:desktop": "bun run electron:install && bun run scripts/development.ts",
        "electron:install": "install-electron",
        "format": "bun fmt --no-config --no-script .",
        "format:check": "bun fmt --no-config --no-script --check .",
        "format:md": "bun fmt --no-config --no-script \"**/*.md\"",
        "format:md:check": "bun fmt --no-config --no-script --check \"**/*.md\"",
        "check": "bun run .agents/skills/quality-check/scripts/check.ts",
        "lint": "eslint . --max-warnings=0 --cache --cache-strategy content --cache-location .cache/eslint/.eslintcache",
        "lint:type-aware": "oxlint -c .oxlintrc.json --type-aware .",
        "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
        "lint:staged": "lint-staged --no-stash",
        "gitleaks": "bun run scripts/gitleaks-scan.ts",
        "docs-check": "bun run scripts/documentation-check.ts",
        "em-dash-check": "bun run scripts/em-dash-check.ts",
        "source-size-ratchet": "bun run scripts/source-size-ratchet.ts",
        "knip": "knip",
        "doctor": "react-doctor --no-score --blocking warning",
        "doctor:changed": "bun run scripts/doctor-changed.ts",
        "typecheck": "bun run typecheck:workspaces && bun check --no-script -p tsconfig.node.json && bun check --no-script -p tsconfig.web.json",
        "typecheck:workspaces": "pnpm --recursive --filter './apps/*' --filter './packages/*' --filter './extensions/*' run typecheck",
        "typecheck:api": "pnpm --filter caxri run typecheck",
        "typecheck:protocol": "pnpm --filter @caxri/protocol run typecheck",
        "typecheck:cli": "pnpm --filter @caxri/cli run typecheck",
        "typecheck:extensions": "pnpm --recursive --filter './extensions/*' run typecheck",
        "test": "bun run .agents/skills/quality-check/scripts/assert-full-suite-authorized.ts unit && vitest run",
        "test:workspaces": "pnpm --recursive --filter './apps/*' --filter './packages/*' run test",
        "test:api": "pnpm --filter caxri run test",
        "test:protocol": "pnpm --filter @caxri/protocol run test",
        "test:cli": "pnpm --filter @caxri/cli run test",
        "test:server-artifact": "bun run scripts/smoke-server-artifact.ts",
        "test:watch": "vitest",
        "refactor:parity": "bun run scripts/refactor-parity.ts",
        "update-model-prices": "bun run scripts/update-model-prices.ts",
        "usage:development": "bun run scripts/update-development-usage.ts",
        "test:e2e": "bun run .agents/skills/quality-check/scripts/assert-full-suite-authorized.ts e2e && bun run build && playwright test",
        "test:e2e:mobile:android": "bun run scripts/mobile-android-acceptance.ts",
        "test:e2e:mobile:desktop": "bun run scripts/mobile-desktop-acceptance.ts",
        "test:e2e:real-agent": "CAXRI_REAL_AGENT_E2E=1 playwright test e2e/real-agent-smoke.e2e.ts",
        "test:smoke": "bun run --silent check e2e/smoke.e2e.ts --e2e",
        "benchmark:startup": "bun run build && playwright test e2e/startup.performance.e2e.ts",
        "benchmark:editor": "bun run build && playwright test e2e/editor.performance.e2e.ts",
        "benchmark:renderer": "CAXRI_REACT_PROFILING=1 bun run build && CAXRI_RENDERER_BENCHMARK=1 CAXRI_E2E_OUTPUT_DIR=test-results/renderer-performance playwright test e2e/renderer.performance.e2e.ts",
        "benchmark:agent-probe": "bun run scripts/agent-probe-benchmark.ts",
        "benchmark:chat-switch": "CAXRI_REACT_PROFILING=1 bun run build && CAXRI_AGENT_CHAT_SWITCH_BENCHMARK=1 CAXRI_E2E_OUTPUT_DIR=test-results/agent-chat-switch-performance playwright test e2e/agent-chat-switch.performance.e2e.ts",
        "benchmark:chat-streaming": "CAXRI_REACT_PROFILING=1 bun run build && CAXRI_AGENT_CHAT_STREAMING_BENCHMARK=1 CAXRI_E2E_OUTPUT_DIR=test-results/agent-chat-streaming-performance playwright test e2e/agent-chat-streaming.performance.e2e.ts",
        "benchmark:markdown": "pnpm --filter @caxri/markdown run benchmark",
        "benchmark:server-footprint": "bun run scripts/server-footprint.ts",
        "benchmark:ssh-link": "bun run scripts/ssh-link-benchmark.ts",
        "benchmark:relay-link": "bun run scripts/relay-link-benchmark.ts",
        "performance:baseline:collect": "bun run scripts/performance-baseline-collect.ts",
        "performance:baseline:derive": "bun run scripts/performance-baseline-derive.ts",
        "performance:baseline:gate": "bun run scripts/performance-baseline-gate.ts",
        "performance:trend:check": "bun run scripts/performance-trend-check.ts",
        "build": "bun run scripts/build-receipt.ts begin && bun run build:workspaces && bun run build:desktop && bun run build:share-extension && bun run scripts/build-receipt.ts record",
        "build:workspaces": "pnpm --recursive --filter './apps/*' --filter './packages/*' --filter './extensions/*' --filter '!@caxri/desktop' --filter '!@caxri/server' --if-present run build && pnpm --filter @caxri/server run build",
        "build:api": "pnpm --filter caxri run build",
        "build:protocol": "pnpm --filter @caxri/protocol run build",
        "build:cli": "pnpm --filter @caxri/cli run build",
        "build:extensions": "pnpm --recursive --filter './extensions/*' run build",
        "build:remote-layers": "pnpm --filter @caxri/server run build:remote",
        "link:cli": "bun run build:cli && bun run apps/cli/scripts/link-global.ts",
        "unlink:cli": "pnpm remove --global @caxri/cli",
        "uninstall:caxri": "bun run scripts/uninstall-caxri.ts",
        "build:desktop": "electron-vite build",
        "build:share-extension": "bun run scripts/build-share-extension.ts",
        "package": "bun run build && bun run build:remote-layers && electron-builder --mac dir",
        "package:e2e": "bun run build && bun run scripts/package-extension-test-app.ts",
        "package:dmg": "bun run build && bun run build:remote-layers && electron-builder --mac dmg --publish never",
        "package:release-dmgs": "bun run scripts/package-release-dmgs.ts",
        "release:prepare": "bun run .agents/skills/release/scripts/prepare-release.ts",
        "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "spike:native": "bun run scripts/native-spike.ts",
        "spike:pty": "bun run scripts/pty-spike.ts",
        "spike:agents": "bun run scripts/agent-discovery-spike.ts"
    },
    "lint-staged": {
        "*.{js,jsx,mjs,cjs}": [
            "bun fmt --no-config --no-script",
            "eslint --fix --cache --cache-strategy content --cache-location .cache/eslint/.eslintcache --no-warn-ignored --max-warnings=0",
            "bun fmt --no-config --no-script"
        ],
        "*.{ts,tsx,mts,cts}": [
            "bun fmt --no-config --no-script",
            "eslint --fix --cache --cache-strategy content --cache-location .cache/eslint/.eslintcache --no-warn-ignored --max-warnings=0",
            "oxlint -c .oxlintrc.json --type-aware --fix --no-error-on-unmatched-pattern",
            "bun fmt --no-config --no-script"
        ],
        "*.md": [
            "markdownlint-cli2 --fix",
            "bun fmt --no-config --no-script"
        ],
        "*.{css,html,json,jsonc,yaml,yml,toml}": [
            "bun fmt --no-config --no-script"
        ]
    },
    "knip": {
        "includeEntryExports": true,
        "ignoreIssues": {
            ".agents/skills/design-prototype/assets/entry.mjs": [
                "exports"
            ],
            ".agents/skills/promo-images/scripts/promo-playwright.config.ts": [
                "exports"
            ],
            "apps/mobile/plugins/*.ts": [
                "exports"
            ],
            "e2e/support/clipboard-capability.type-test.ts": [
                "exports"
            ],
            "e2e/support/server-database/*.ts": [
                "exports"
            ],
            "extensions/*/src/extension.ts": [
                "exports"
            ],
            "scripts/fixtures/**": [
                "exports",
                "types"
            ]
        },
        "ignoreBinaries": [
            "fmt",
            "mkfifo"
        ],
        "workspaces": {
            ".": {
                "entry": [
                    ".agents/skills/acceptance/scripts/capture-renderer.ts",
                    "e2e/support/server-database/*-seed.ts",
                    "e2e/support/server-database/timeline-read.ts",
                    ".agents/skills/acceptance/scripts/fixture-preflight.ts",
                    ".agents/skills/acceptance/scripts/report.ts",
                    ".agents/skills/acceptance/scripts/start-electron.ts",
                    ".agents/skills/acceptance/scripts/stop-electron.ts",
                    ".agents/skills/audit-ux/scripts/render-count.ts",
                    ".agents/skills/design-prototype/assets/entry.mjs",
                    ".agents/skills/design-prototype/scripts/build-runtime.ts",
                    ".agents/skills/design-prototype/scripts/verify-prototype.ts",
                    ".agents/skills/debug/scripts/collect-macos-gpu-logs.ts",
                    ".agents/skills/promo-images/scripts/promo.ts",
                    ".agents/skills/promo-images/scripts/promo-capture.pw.ts",
                    ".agents/skills/promo-images/scripts/promo-compose.ts",
                    ".agents/skills/promo-images/scripts/promo-playwright.config.ts",
                    "e2e/support/clipboard-capability.type-test.ts",
                    "scripts/ssh-link-throttle.ts",
                    "scripts/reporters/e2e-receipt-reporter.ts",
                    "scripts/fixtures/e2e-census.fixture.ts",
                    "scripts/fixtures/playwright-census.config.ts",
                    "scripts/fixtures/eslint/native-title/native-title-fixture.jsx",
                    "scripts/fixtures/eslint/no-render-translate/*.{ts,tsx}",
                    "scripts/fixtures/eslint/type-aware-violation.ts",
                    "scripts/fixtures/eslint/anti-slop-violation.ts",
                    "scripts/fixtures/eslint/no-sync-fixture.ts",
                    "scripts/fixtures/eslint/bounded-external-reads/*.ts",
                    "scripts/fixtures/eslint/NotKebabCaseFixture.ts",
                    "scripts/fixtures/eslint/child-process-exec-fixture.ts",
                    "scripts/fixtures/eslint/spawn-shell-true-fixture.ts",
                    "scripts/fixtures/eslint/good-mapped-component-fixture.tsx",
                    "scripts/fixtures/eslint/bad-mapped-component-fixture.tsx",
                    "scripts/fixtures/eslint/use-good-mapped-hook-fixture.ts",
                    "scripts/fixtures/eslint/use-bad-mapped-hook-fixture.ts",
                    "scripts/fixtures/eslint/arrow-component-fixture.tsx",
                    "scripts/fixtures/eslint/class-component-fixture.tsx",
                    "scripts/fixtures/eslint/compound-component-fixture.tsx",
                    "scripts/fixtures/eslint/compound-component-mismatch-fixture.tsx",
                    "scripts/fixtures/eslint/no-function-export-fixture.tsx",
                    "scripts/fixtures/eslint/re-export-component-fixture.tsx",
                    "scripts/fixtures/eslint/use-wrong-casing-hook-fixture.ts",
                    "scripts/fixtures/eslint/wrong-casing-component-fixture.tsx",
                    "scripts/fixtures/eslint/class-members-packed-methods-fixture.ts",
                    "scripts/fixtures/eslint/class-members-spaced-methods-fixture.ts",
                    "scripts/fixtures/eslint/feature-structure/**/*.ts",
                    "scripts/fixtures/eslint/architecture/**/*.ts",
                    "scripts/fixtures/eslint/view-container-reads/**/*.ts",
                    "scripts/fixtures/eslint/color-utilities/**/*.ts",
                    "scripts/fixtures/eslint/listener-fanout/**/*.ts",
                    "scripts/fixtures/eslint/schema-version-offset/**/*.ts",
                    "scripts/fixtures/eslint/relative-import-extension/**/*.ts",
                    "scripts/run-e2e-failure-isolation.ts",
                    "scripts/run-e2e-pools.ts",
                    "scripts/surface-matrix.ts"
                ],
                "ignore": [
                    ".agents/skills/deep-review/scripts/vitest.config.ts",
                    "tools/oxlint/anti-slop/**"
                ],
                "ignoreFiles": [
                    ".agents/skills/design-prototype/assets/*.js"
                ],
                "ignoreDependencies": [
                    "@babel/plugin-syntax-typescript",
                    "@caxri/utils",
                    "react-scan",
                    "tailwindcss",
                    "tw-animate-css",
                    "ws"
                ]
            },
            "apps/desktop": {
                "entry": [
                    "src/main/bootstrap.ts",
                    "src/preload/performance-monitor.ts",
                    "src/preload/process-explorer.ts",
                    "src/renderer/src/caxri-bot-main.tsx",
                    "src/renderer/src/benchmark-main.tsx",
                    "src/renderer/src/main.tsx",
                    "src/renderer/src/performance-monitor-main.tsx",
                    "src/renderer/src/process-explorer-main.tsx",
                    "src/renderer/src/startup-background.ts"
                ]
            },
            "apps/server": {
                "entry": [
                    "src/domains/agent-chat/__tests__/fixtures/fake-claude-cli.ts",
                    "src/domains/agent-chat/__tests__/fixtures/fake-codex-app-server.ts",
                    "src/domains/agent-chat/__tests__/fixtures/fake-grok-acp.ts",
                    "src/terminal-host/agent-launcher/process.ts",
                    "src/extension-host/process.ts",
                    "src/core/bootstrap.ts",
                    "src/terminal-host/process.ts"
                ]
            },
            "apps/mobile": {
                "entry": [
                    "plugins/with-android-mlkit-keep-rules.ts",
                    "plugins/with-android-release-signing.ts",
                    "plugins/with-android-sdk-download-disabled.ts",
                    "plugins/with-mobile-network-policy.ts"
                ],
                "ignoreDependencies": [
                    "expo-updates"
                ]
            },
            "*/cli": {
                "entry": [
                    "src/bin.ts"
                ]
            },
            "packages/agent-skills": {
                "includeEntryExports": false
            },
            "extensions/fixture": {
                "entry": [
                    "src/extension.ts"
                ],
                "ignoreDependencies": [
                    "@caxri/protocol"
                ]
            },
            "extensions/git": {
                "entry": [
                    "src/extension.ts"
                ],
                "ignoreDependencies": [
                    "@caxri/protocol"
                ]
            },
            "extensions/status": {
                "entry": [
                    "src/extension.ts"
                ],
                "ignoreDependencies": [
                    "@caxri/protocol"
                ]
            }
        }
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/plugin-syntax-typescript": "^7.29.7",
        "@caxri/client": "workspace:*",
        "@caxri/protocol": "workspace:*",
        "@caxri/system": "workspace:*",
        "@caxri/utils": "workspace:*",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@oxlint/plugins": "^1.89.0",
        "@playwright/test": "^1.64.1",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tailwindcss/vite": "^4.3.3",
        "@types/babel__core": "^7.20.5",
        "@types/better-sqlite3": "^9.6.0",
        "@types/estree": "^1.0.9",
        "@types/mdast": "^4.0.4",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/semver": "catalog:",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitejs/plugin-react": "^6.1.2",
        "@yutengjing/eslint-config-typescript": "catalog:",
        "babel-plugin-react-compiler": "^1.0.0",
        "better-sqlite3": "^13.0.3",
        "caxri": "workspace:*",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "comment-parser": "^1.4.9",
        "drizzle-kit": "^0.31.11",
        "electron": "^45.0.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^6.0.0",
        "eslint": "^10.13.0",
        "eslint-plugin-import-x": "catalog:",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "jsonc-parser": "^3.3.1",
        "knip": "^6.42.1",
        "lint-staged": "^17.6.0",
        "lucide-react": "^1.59.0",
        "markdownlint": "catalog:",
        "markdownlint-cli2": "catalog:",
        "mdast-util-from-markdown": "^2.1.0",
        "motion": "^14.4.0",
        "node-pty": "^1.1.0",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "playwright": "^1.64.1",
        "react": "^19.3.1",
        "react-doctor": "^0.9.18",
        "react-dom": "^19.3.1",
        "react-scan": "catalog:",
        "semver": "catalog:",
        "sonda": "catalog:",
        "string-width": "^8.3.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "ws": "catalog:",
        "yaml": "^2.9.1",
        "zod": "catalog:",
        "zustand": "^5.0.15"
    },
    "build": {
        "appId": "com.caxri.app",
        "productName": "Caxri",
        "extraMetadata": {
            "main": "out/main/index.js",
            "name": "@caxri/desktop",
            "productName": "Caxri"
        },
        "electronFuses": {
            "runAsNode": true
        },
        "directories": {
            "output": "release.noindex"
        },
        "asar": true,
        "extraResources": [
            {
                "from": "apps/cli/dist/caxri.cjs",
                "to": "cli/caxri.cjs"
            },
            {
                "from": "build/caxri",
                "to": "bin/caxri"
            },
            {
                "from": "build/notification-icon.png",
                "to": "notification-icon.png"
            },
            {
                "from": "apps/server/dist/server",
                "to": "server"
            },
            {
                "from": "apps/server/dist/remote",
                "to": "remote",
                "filter": [
                    "*/descriptor.json",
                    "*/app.tar.gz"
                ]
            },
            {
                "from": "out/mobile-update",
                "to": "mobile"
            }
        ],
        "files": [
            "out/**",
            "package.json",
            "LICENSE",
            "THIRD_PARTY_NOTICES.md",
            "licenses/**"
        ],
        "electronLanguages": [
            "en",
            "en_GB",
            "zh_CN",
            "zh_TW"
        ],
        "mac": {
            "category": "public.app-category.developer-tools",
            "extendInfo": {
                "CaxriSchemaBaseline": 55,
                "CFBundleDocumentTypes": [
                    {
                        "CFBundleTypeName": "Caxri Share Request",
                        "CFBundleTypeRole": "Viewer",
                        "LSHandlerRank": "Owner",
                        "LSItemContentTypes": [
                            "com.caxri.share-request"
                        ]
                    }
                ],
                "UTExportedTypeDeclarations": [
                    {
                        "UTTypeConformsTo": [
                            "public.json"
                        ],
                        "UTTypeDescription": "Caxri Share Request",
                        "UTTypeIdentifier": "com.caxri.share-request",
                        "UTTypeTagSpecification": {
                            "public.filename-extension": [
                                "caxrishare"
                            ]
                        }
                    }
                ]
            },
            "extraFiles": [
                {
                    "from": "out/share-extension/Caxri Share.appex",
                    "to": "PlugIns/Caxri Share.appex"
                }
            ],
            "hardenedRuntime": false,
            "icon": "build/icon.icns",
            "identity": "-",
            "signIgnore": [
                "Caxri Share\\.appex",
                "Contents/Resources/server/"
            ],
            "target": [
                "dir"
            ]
        }
    },
    "engines": {
        "node": ">=24.0.0",
        "bun": ">=1.3.0"
    }
}
