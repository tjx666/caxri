    "projects": [
        {
            "key": "storefront",
            "name": "storefront",
            "branch": "feat/coupon-codes",
            "commits": [
                {
                    "message": "Add the checkout total",
                    "files": {
                        "package.json": [
                            "{",
                            "  \"name\": \"storefront\",",
                            "  \"private\": true,",
                            "  \"type\": \"module\",",
                            "  \"scripts\": { \"test\": \"vitest run\" },",
                            "  \"devDependencies\": { \"vitest\": \"^4.0.0\" }",
                            "}"
                        ],
                        "src/checkout/total.ts": [
                            "import type { Cart } from '../cart/cart';",
                            "",
                            "const TAX_RATE = 0.08;",
                            "",
                            "export interface CheckoutTotal {",
                            "    subtotal: number;",
                            "    tax: number;",
                            "    total: number;",
                            "}",
                            "",
                            "export function checkoutTotal(cart: Cart): CheckoutTotal {",
                            "    const subtotal = cart.items.reduce((sum, item) => sum + item.price * item.quantity, 0);",
                            "    const tax = Math.round(subtotal * TAX_RATE * 100) / 100;",
                            "    return { subtotal, tax, total: subtotal + tax };",
                            "}"
                        ],
                        "src/cart/cart.ts": [
                            "export interface CartItem {",
                            "    sku: string;",
                            "    price: number;",
                            "    quantity: number;",
                            "}",
                            "",
                            "export interface Cart {",
                            "    items: CartItem[];",
                            "    updatedAt: Date;",
                            "}"
                        ]
                    }
                },
                {
                    "message": "Cover the cart total",
                    "files": {
                        "src/cart/cart-total.test.ts": [
                            "import { expect, it } from 'vitest';",
                            "",
                            "import { checkoutTotal } from '../checkout/total';",
                            "",
                            "it('totals a cart updated today', () => {",
                            "    const cart = { items: [{ sku: 'mug', price: 12, quantity: 2 }], updatedAt: new Date() };",
                            "    expect(checkoutTotal(cart).total).toBe(25.92);",
                            "});"
                        ]
                    }
                }
            ],
            "changes": {
                "src/checkout/coupons.ts": [
                    "export interface Coupon {",
                    "    code: string;",
                    "    percentOff: number;",
                    "    minimumSubtotal: number;",
                    "    expiresAt: Date;",
                    "}",
                    "",
                    "export function couponDiscount(coupon: Coupon, subtotal: number, now = new Date()): number {",
                    "    if (now > coupon.expiresAt || subtotal < coupon.minimumSubtotal) return 0;",
                    "    return Math.round(subtotal * coupon.percentOff) / 100;",
                    "}"
                ],
                "src/checkout/total.ts": [
                    "import type { Cart } from '../cart/cart';",
                    "import type { Coupon } from './coupons';",
                    "import { couponDiscount } from './coupons';",
                    "",
                    "const TAX_RATE = 0.08;",
                    "",
                    "export interface CheckoutTotal {",
                    "    subtotal: number;",
                    "    discount: number;",
                    "    tax: number;",
                    "    total: number;",
                    "}",
                    "",
                    "export function checkoutTotal(cart: Cart, coupon?: Coupon): CheckoutTotal {",
                    "    const subtotal = cart.items.reduce((sum, item) => sum + item.price * item.quantity, 0);",
                    "    const discount = coupon ? couponDiscount(coupon, subtotal) : 0;",
                    "    const tax = Math.round((subtotal - discount) * TAX_RATE * 100) / 100;",
                    "    return { subtotal, discount, tax, total: subtotal - discount + tax };",
                    "}"
                ],
                "src/checkout/coupons.test.ts": [
                    "import { expect, it } from 'vitest';",
                    "",
                    "import { couponDiscount } from './coupons';",
                    "",
                    "const coupon = { code: 'SPRING10', percentOff: 10, minimumSubtotal: 50, expiresAt: new Date('2026-04-01') };",
                    "",
                    "it('takes 10% off a qualifying subtotal', () => {",
                    "    expect(couponDiscount(coupon, 80, new Date('2026-03-10'))).toBe(8);",
                    "});",
                    "",
                    "it('ignores an expired coupon', () => {",
                    "    expect(couponDiscount(coupon, 80, new Date('2026-04-02'))).toBe(0);",
                    "});",
                    "",
                    "it('ignores a subtotal below the minimum', () => {",
                    "    expect(couponDiscount(coupon, 40, new Date('2026-03-10'))).toBe(0);",
                    "});"
                ]
            }
        },
        {
            "key": "billing",
            "name": "billing-service",
            "commits": [
                {
                    "message": "Add invoices and receipts",
                    "files": {
                        "package.json": [
                            "{",
                            "  \"name\": \"billing-service\",",
                            "  \"private\": true,",
                            "  \"type\": \"module\",",
                            "  \"scripts\": { \"test\": \"vitest run\" }",
                            "}"
                        ],
                        "src/invoices/invoice-total.ts": [
                            "import type { InvoiceLine } from './invoice';",
                            "",
                            "export function invoiceTotal(lines: InvoiceLine[]): number {",
                            "    const total = lines.reduce((sum, line) => sum + line.unitPrice * line.quantity, 0);",
                            "    return Number(total.toFixed(2));",
                            "}"
                        ],
                        "src/invoices/invoice.ts": [
                            "export interface InvoiceLine {",
                            "    description: string;",
                            "    unitPrice: number;",
                            "    quantity: number;",
                            "}"
                        ],
                        "src/receipts/receipt.ts": [
                            "export interface ReceiptLine {",
                            "    label: string;",
                            "    amount: number;",
                            "}",
                            "",
                            "export function receiptLines(subtotal: number): ReceiptLine[] {",
                            "    return [{ label: 'Total', amount: subtotal }];",
                            "}"
                        ]
                    }
                }
            ],
            "changes": {
                "src/receipts/receipt.ts": [
                    "export interface ReceiptLine {",
                    "    label: string;",
                    "    amount: number;",
                    "}",
                    "",
                    "export function receiptLines(subtotal: number, tax: number): ReceiptLine[] {",
                    "    return [",
                    "        { label: 'Subtotal', amount: subtotal },",
                    "        { label: 'Tax', amount: tax },",
                    "        { label: 'Total', amount: subtotal + tax },",
                    "    ];",
                    "}"
                ]
            }
        },
