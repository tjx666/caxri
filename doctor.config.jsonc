{
    "ignore": {
        // Third-party competitor repositories cloned locally for analysis (gitignored;
        // absent from CI checkouts). Findings there are not ours to fix. Negative lint
        // fixtures violate rules on purpose so the toolchain contract tests can prove the
        // rules fire; they must never fail a real gate.
        "files": ["competitors/**", "scripts/fixtures/**"],
        "overrides": [
            {
                // False positive: every one of these files is only reachable through
                // React.lazy(() => import(...)) boundaries (EditorSurface and the settings
                // forms), so the static monaco imports stay inside the lazily loaded chunk
                // and never run at startup. The rule only inspects import syntax per file.
                "files": [
                    "apps/desktop/src/renderer/src/features/editor/agent-transcript-editor.tsx",
                    "apps/desktop/src/renderer/src/features/editor/code-editor.tsx",
                    "apps/desktop/src/renderer/src/features/editor/git-diff-editor.tsx",
                    "apps/desktop/src/renderer/src/features/editor/git-diff-surface.tsx",
                    "apps/desktop/src/renderer/src/features/editor/git-single-diff-editor.tsx",
                    "apps/desktop/src/renderer/src/features/settings/config-editor.tsx",
                    "apps/desktop/src/renderer/src/lib/monaco.ts",
                    // React Doctor evaluates the base tree with the candidate config. Keep the
                    // pre-cutover paths equivalent so a pure directory move cannot manufacture
                    // a changed-scope regression.
                    "src/renderer/src/features/editor/agent-transcript-editor.tsx",
                    "src/renderer/src/features/editor/code-editor.tsx",
                    "src/renderer/src/features/editor/git-diff-editor.tsx",
                    "src/renderer/src/features/editor/git-diff-surface.tsx",
                    "src/renderer/src/features/editor/git-single-diff-editor.tsx",
                    "src/renderer/src/features/settings/config-editor.tsx",
                    "src/renderer/src/lib/monaco.ts",
                ],
                "rules": ["react-doctor/prefer-dynamic-import"],
            },
            {
                // Deliberate sequential awaits: each of these loops orders its awaits on
                // purpose (lock/journal ordering, xterm parser writes, bounded retries,
                // chunked copies). Every site carries an eslint no-await-in-loop disable
                // with an inline rationale; the ESLint gate is the adjudicating owner.
                "files": [
                    "apps/cli/scripts/validate-skill.ts",
                    "apps/server/src/domains/agents/external-conversations.ts",
                    "apps/server/src/domains/commander/handover.ts",
                    "packages/agent-skills/src/execute.ts",
                    "packages/agent-skills/src/filesystem.ts",
                    "apps/desktop/src/main/menu-refresh.ts",
                    "apps/desktop/src/renderer/src/lib/monaco.ts",
                    "apps/server/src/core/binary-stream-runtime.ts",
                    "apps/server/src/domains/agents/hooks/manager.ts",
                    "apps/server/src/domains/files/mutation-journal.ts",
                    "apps/server/src/domains/files/mutations-copy.ts",
                    "apps/server/src/domains/terminal/file-links.ts",
                    "apps/server/src/domains/agents/transcript-discovery.ts",
                    "apps/server/src/terminal-host/engine/screen.ts",
                    "packages/client/src/supervise/binary-stream-client.ts",
                    "packages/system/src/observability/process-manifest.ts",
                    "src/main/menu-refresh.ts",
                    "src/renderer/src/lib/monaco.ts",
                ],
                "rules": ["react-doctor/async-await-in-loop"],
            },
            {
                // The chrome-layout key is intentionally versioned because its fields define one
                // device-local layout schema shared by all three chrome regions.
                "files": [
                    "apps/desktop/src/renderer/src/stores/chrome-layout.ts",
                    "src/renderer/src/stores/chrome-layout.ts",
                ],
                "rules": ["react-doctor/client-localstorage-no-version"],
            },
            {
                // Keybinding rows have no stable identity: both the key and the command are
                // editable in place and rows are addressed by index (onFieldChange(index, ...)),
                // so an index-derived key is the correct choice here.
                "files": ["apps/desktop/src/renderer/src/features/settings/keybindings-form.tsx"],
                "rules": ["react-doctor/no-array-index-as-key"],
            },
            {
                // Socket scores @yutengjing/vscode-icons low on popularity because it is a
                // freshly published package, but this project's owner maintains it.
                "files": ["package.json"],
                "rules": ["socket/low-supply-chain-score"],
            },
            {
                // React Doctor does not scan repository skill scripts. string-width is used by
                // Acceptance's terminal grid preflight and is also enforced by knip.
                "files": ["package.json"],
                "rules": ["deslop/unused-dev-dependency"],
            },
            {
                // False positive: the lstat -> readdir -> lstat/realpath sequence in
                // ListingService.loadList is a deliberate TOCTOU revalidation (see the inline
                // JSDoc); the awaits are ordered on purpose and must not be parallelized.
                "files": ["apps/server/src/domains/files/listing.ts"],
                "rules": ["react-doctor/server-sequential-independent-await"],
            },
            {
                // False positive: the rule looks for a revoke beside the create, and this module
                // deliberately separates them. One preview asset is shared by every element that
                // refers to it, so the URL is refcounted and `releaseAsset` revokes it when the
                // last holder lets go; revoking beside `createObjectURL` would break the sharing
                // the cache exists for. `__tests__/preview-asset-client.test.ts` covers every
                // acquire/release path, including the revoke.
                "files": [
                    "apps/desktop/src/renderer/src/features/preview/preview-asset-client.ts",
                    // `@caxri/desktop` reports its findings relative to its own root.
                    "src/renderer/src/features/preview/preview-asset-client.ts",
                ],
                "rules": ["react-doctor/no-create-object-url-without-revoke"],
            },
            {
                // Runtime domains deliberately expose index.ts boundaries. Cross-domain consumers
                // must import those roots instead of reaching into implementation modules; the
                // structure contract enforces this architecture rule.
                "files": [
                    "apps/server/src/core/create-domain-service.ts",
                    "apps/server/src/domains/agent-runtime/runtime.ts",
                    "apps/server/src/domains/bootstrap-service-handlers.ts",
                    "apps/server/src/domains/bootstrap.ts",
                    "apps/server/src/domains/create-domain-services.ts",
                    "apps/server/src/domains/git/index.ts",
                    "apps/server/src/domains/project-status/branch.ts",
                    "apps/server/src/domains/project-status/index.ts",
                    "apps/server/src/domains/project-status/session-pull-requests.ts",
                    "apps/server/src/domains/service-handlers.ts",
                    "apps/server/src/domains/session/auto-naming.ts",
                    "apps/server/src/domains/terminal/index.ts",
                ],
                "rules": ["react-doctor/no-barrel-import"],
            },
            {
                // Vendored VS Code codicon paths keep the upstream repository's exact coordinates
                // (CC BY 4.0, licenses/VSCODE_CODICONS_LICENSE.txt) so the assets stay auditable
                // against their source instead of being re-rounded per icon.
                "files": [
                    "apps/desktop/src/renderer/src/icons/codicons/**",
                    "src/renderer/src/icons/codicons/**",
                ],
                "rules": ["react-doctor/rendering-svg-precision"],
            },
            {
                // These collections are explicitly bounded (durable recovery pages and at most
                // 100 causal capsules). Keeping filter/map separate preserves the validation and
                // cloning stages without creating a meaningful hot-path allocation.
                "files": [
                    "apps/desktop/src/renderer/src/stores/selectors.ts",
                    "packages/protocol/src/transport/event-journal.ts",
                    "packages/system/src/observability/causal-chain.ts",
                    "src/renderer/src/stores/selectors.ts",
                ],
                "rules": ["react-doctor/js-combine-iterations"],
            },
            {
                // The deleted baseline files below are evaluated with this candidate config by
                // React Doctor's changed-scope comparison. Their current equivalents no longer
                // trigger these findings, so suppressing only the baseline paths prevents a
                // directory migration from being reported as newly introduced code.
                "files": [
                    "src/renderer/src/features/terminal/terminal-links.ts",
                    "src/renderer/src/features/workbench/workbench-root-prompt.tsx",
                ],
                "rules": [
                    "react-doctor/js-set-map-lookups",
                    "react-doctor/no-loading-flag-reset-outside-finally",
                ],
            },
            {
                // Caxri already runs these schemas on Zod 4.5.2. React Doctor classifies the
                // supported object().strict() spelling as a pre-Zod-4 migration hazard, although
                // the schemas are exercised by protocol, artifact, and IPC behavior tests.
                "files": [
                    "apps/server/src/extension-host/protocol.ts",
                    "apps/server/src/observability/context-schema.ts",
                    "apps/server/src/terminal-host/launch-plan-schema.ts",
                    "apps/server/src/terminal-host/protocol.ts",
                    "packages/protocol/src/transport/binary-stream.ts",
                    "packages/protocol/src/transport/identity.ts",
                    "packages/protocol/src/transport/server-artifact.ts",
                    "scripts/refactor-parity/contracts.ts",
                ],
                "rules": ["react-doctor/zod-v4-no-deprecated-schema-apis"],
            },
        ],
    },
}
