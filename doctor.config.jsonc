{
    "ignore": {
        // Third-party competitor repositories cloned locally for analysis (gitignored;
        // absent from CI checkouts). Findings there are not ours to fix.
        "files": ["competitors/**"],
        "overrides": [
            {
                // False positive: every one of these files is only reachable through
                // React.lazy(() => import(...)) boundaries (EditorSurface and the settings
                // forms), so the static monaco imports stay inside the lazily loaded chunk
                // and never run at startup. The rule only inspects import syntax per file.
                "files": [
                    "src/renderer/src/features/editor/CodeEditor.tsx",
                    "src/renderer/src/features/editor/GitDiffEditor.tsx",
                    "src/renderer/src/features/settings/ConfigurationEditor.tsx",
                    "src/renderer/src/lib/monaco.ts",
                ],
                "rules": ["react-doctor/prefer-dynamic-import"],
            },
            {
                // Keybinding rows have no stable identity: both the key and the command are
                // editable in place and rows are addressed by index (onFieldChange(index, ...)),
                // so an index-derived key is the correct choice here.
                "files": ["src/renderer/src/features/settings/KeybindingsForm.tsx"],
                "rules": ["react-doctor/no-array-index-as-key"],
            },
            {
                // Socket scores @lobehub/assets-fileicon low on popularity, but it is the
                // official LobeHub asset package and this project's owner maintains LobeHub.
                "files": ["package.json"],
                "rules": ["socket/low-supply-chain-score"],
            },
            {
                // React Doctor does not scan repository skill scripts. string-width is used by
                // Acceptance's terminal grid preflight and is also enforced by knip.
                "files": ["package.json"],
                "rules": ["deslop/unused-dev-dependency"],
            },
            {
                // False positive: the lstat -> readdir -> lstat/realpath sequence in
                // ListingService.loadList is a deliberate TOCTOU revalidation (see the inline
                // JSDoc); the awaits are ordered on purpose and must not be parallelized.
                "files": ["src/runtime/files/listing.ts"],
                "rules": ["react-doctor/server-sequential-independent-await"],
            },
            {
                // Runtime domains deliberately expose index.ts boundaries. Cross-domain consumers
                // must import those roots instead of reaching into implementation modules; the
                // structure contract enforces this architecture rule.
                "files": ["src/runtime/bootstrap.ts", "src/runtime/terminal/index.ts"],
                "rules": ["react-doctor/no-barrel-import"],
            },
        ],
    },
}
