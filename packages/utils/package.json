{
    "name": "@caxri/utils",
    "version": "0.0.1",
    "private": true,
    "description": "Browser-safe, dependency-free utility functions shared across Caxri workspaces.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "bun": "./src/index.ts",
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run --root ../.. --project utils",
        "typecheck": "tsc --noEmit -p tsconfig.json --incremental --tsBuildInfoFile ../../.cache/tsc/packages-utils.tsbuildinfo"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
