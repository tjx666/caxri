{
    "compilerOptions": {
        "outDir": "dist",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "lib": ["ES2025", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "strict": true,
        "target": "ES2023",
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
