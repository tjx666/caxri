{
    "name": "@caxri/client",
    "version": "0.0.19",
    "private": true,
    "description": "Shared Caxri connection, recovery, state, and Server supervision client.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        },
        "./connection": {
            "types": "./src/connection/index.ts",
            "import": "./dist/connection/index.js"
        },
        "./state": {
            "types": "./src/state/index.ts",
            "import": "./dist/state/index.js"
        },
        "./supervise": {
            "types": "./src/supervise/index.ts",
            "import": "./dist/supervise/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run --root ../.. --project client",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@caxri/protocol": "workspace:*",
        "ws": "catalog:"
    },
    "devDependencies": {
        "@types/ws": "catalog:"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
