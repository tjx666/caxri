{
    "name": "@caxri/system",
    "version": "0.0.1",
    "private": true,
    "description": "Shared operating-system, process, filesystem, and observability primitives for Caxri applications.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "bun": "./src/index.ts",
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run --root ../.. --project system",
        "typecheck": "tsc --noEmit -p tsconfig.json --incremental --tsBuildInfoFile ../../.cache/tsc/packages-system.tsbuildinfo"
    },
    "dependencies": {
        "@caxri/protocol": "workspace:*",
        "@caxri/utils": "workspace:*",
        "es-toolkit": "^1.52.0",
        "jsonc-parser": "^3.3.1"
    },
    "devDependencies": {
        "@types/node": "^24.19.2"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
