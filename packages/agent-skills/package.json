{
    "name": "@caxri/agent-skills",
    "version": "0.0.141",
    "private": true,
    "description": "Provider-neutral Caxri Agent skill installation and health integration.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "bun": "./src/index.ts",
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        },
        "./testing": {
            "bun": "./src/testing.ts",
            "types": "./src/testing.ts",
            "import": "./dist/testing.js"
        }
    },
    "scripts": {
        "build": "bun run scripts/generate-skill-bundle.ts && tsc -p tsconfig.build.json && bun run scripts/verify-exports.ts",
        "test": "vitest run --root ../.. --project agent-skills",
        "typecheck": "bun check --no-script -p tsconfig.json"
    },
    "dependencies": {
        "@caxri/protocol": "workspace:*",
        "@caxri/system": "workspace:*"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
