{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "lib": ["ES2025"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "strict": true,
        "target": "ES2023",
        "types": ["node"]
    },
    "include": ["scripts/**/*.ts", "src/**/*.ts"]
}
