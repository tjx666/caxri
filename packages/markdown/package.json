{
    "name": "@caxri/markdown",
    "version": "0.0.1",
    "private": true,
    "description": "Browser-safe Caxri Markdown rendering pipeline shared by every preview client.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "bun": "./src/index.ts",
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        },
        "./blocks": {
            "bun": "./src/blocks.ts",
            "types": "./src/blocks.ts",
            "import": "./dist/blocks.js"
        },
        "./file-reference": {
            "bun": "./src/file-reference.ts",
            "types": "./src/file-reference.ts",
            "import": "./dist/file-reference.js"
        },
        "./prose-web-links": {
            "bun": "./src/prose-web-links.ts",
            "types": "./src/prose-web-links.ts",
            "import": "./dist/prose-web-links.js"
        }
    },
    "scripts": {
        "benchmark": "bun run scripts/streaming-benchmark.ts",
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run --root ../.. --project markdown",
        "typecheck": "bun check --no-script -p tsconfig.json"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "dependencies": {
        "markdown-it": "catalog:"
    }
}
