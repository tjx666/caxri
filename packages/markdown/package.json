{
    "name": "@caxri/markdown",
    "version": "0.0.1",
    "private": true,
    "description": "Browser-safe Caxri Markdown rendering pipeline shared by every preview client.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "bun": "./src/index.ts",
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run --root ../.. --project markdown",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "dependencies": {
        "markdown-it": "^15.0.2"
    }
}
