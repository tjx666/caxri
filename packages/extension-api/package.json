{
    "name": "caxri",
    "version": "0.0.44",
    "description": "Public ESM API for Caxri extensions.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run --root ../.. --project api",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
