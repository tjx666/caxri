{
    "name": "@caxri/protocol",
    "version": "0.0.6",
    "private": true,
    "description": "Browser-safe Caxri command and event protocol.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run --root ../.. packages/protocol/src/index.test.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
